{
  "name": "interlinear",
  "displayName": "Interlinear - Local Comment Translator",
  "description": "%description%",
  "version": "0.1.2",
  "publisher": "mitsutan",
  "license": "MIT",
  "icon": "images/icon.png",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "interlinear.server.mode",
        "interlinear.endpoint",
        "interlinear.server.llamaServerPath",
        "interlinear.server.modelPath"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:shellscript",
    "onLanguage:css",
    "onLanguage:powershell"
  ],
  "contributes": {
    "commands": [
      {
        "command": "interlinear.setup",
        "title": "%command.setup%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.restartServer",
        "title": "%command.restartServer%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.showServerLog",
        "title": "%command.showServerLog%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.removeModels",
        "title": "%command.removeModels%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.toggle",
        "title": "%command.toggle%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.toggleInline",
        "title": "%command.toggleInline%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.checkServer",
        "title": "%command.checkServer%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.clearCache",
        "title": "%command.clearCache%",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.showMenu",
        "title": "%command.showMenu%",
        "category": "Interlinear"
      }
    ],
    "configuration": {
      "title": "Interlinear",
      "properties": {
        "interlinear.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "interlinear.translateDocumentation": {
          "type": "boolean",
          "default": true,
          "description": "%config.translateDocumentation%"
        },
        "interlinear.inlineTranslation": {
          "type": "string",
          "enum": [
            "off",
            "short",
            "all"
          ],
          "enumDescriptions": [
            "%config.inlineTranslation.off%",
            "%config.inlineTranslation.short%",
            "%config.inlineTranslation.all%"
          ],
          "default": "short",
          "description": "%config.inlineTranslation%"
        },
        "interlinear.inlineMaxWidth": {
          "type": "number",
          "default": 120,
          "minimum": 40,
          "maximum": 1000,
          "markdownDescription": "%config.inlineMaxWidth%"
        },
        "interlinear.server.mode": {
          "type": "string",
          "enum": [
            "managed",
            "external"
          ],
          "enumDescriptions": [
            "%config.server.mode.managed%",
            "%config.server.mode.external%"
          ],
          "default": "managed",
          "markdownDescription": "%config.server.mode%"
        },
        "interlinear.server.model": {
          "type": "string",
          "enum": [
            "0.8b",
            "2b",
            "8b"
          ],
          "enumDescriptions": [
            "%config.server.model.0.8b%",
            "%config.server.model.2b%",
            "%config.server.model.8b%"
          ],
          "default": "2b",
          "markdownDescription": "%config.server.model%"
        },
        "interlinear.server.idleTimeoutMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "markdownDescription": "%config.server.idleTimeoutMinutes%"
        },
        "interlinear.server.llamaServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.server.llamaServerPath%",
          "scope": "machine"
        },
        "interlinear.server.modelPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.server.modelPath%",
          "scope": "machine"
        },
        "interlinear.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:18080",
          "markdownDescription": "%config.endpoint%"
        },
        "interlinear.targetLanguage": {
          "type": "string",
          "default": "",
          "description": "%config.targetLanguage%"
        },
        "interlinear.sourceLanguage": {
          "type": "string",
          "default": "",
          "description": "%config.sourceLanguage%"
        },
        "interlinear.form": {
          "type": "string",
          "enum": [
            "plain",
            "polite",
            "none"
          ],
          "enumDescriptions": [
            "%config.form.plain%",
            "%config.form.polite%",
            "%config.form.none%"
          ],
          "default": "plain",
          "description": "%config.form%"
        },
        "interlinear.useContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.useContext%"
        },
        "interlinear.glossary": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.glossary%",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "interlinear.prefetch": {
          "type": "boolean",
          "default": true,
          "description": "%config.prefetch%"
        },
        "interlinear.maxConcurrentRequests": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "%config.maxConcurrentRequests%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node esbuild.mjs --tests && node test/integration/run.ts",
    "package": "node esbuild.mjs --production && node scripts/package.ts",
    "check:manifest": "node scripts/check-manifest.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/vscode": "1.100.0",
    "@vscode/l10n": "0.0.18",
    "@vscode/test-electron": "3.1.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitsutan/vscode-interlinear.git"
  },
  "bugs": {
    "url": "https://github.com/Mitsutan/vscode-interlinear/issues"
  },
  "homepage": "https://github.com/Mitsutan/vscode-interlinear#readme",
  "keywords": [
    "translation",
    "comment",
    "documentation",
    "hover",
    "japanese",
    "local",
    "llm",
    "llama.cpp",
    "plamo"
  ],
  "l10n": "./l10n"
}
