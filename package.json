{
  "name": "interlinear",
  "displayName": "Interlinear - Local Comment Translator",
  "description": "ソースコードのコメントと、ホバーで表示されるドキュメントを、ローカルの翻訳モデル（PLaMo 3 Translate + llama.cpp）で翻訳して表示する",
  "version": "0.1.0",
  "publisher": "mitsutan",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "信頼されていないワークスペースでは、ワークスペースの設定で翻訳サーバーの接続先や動作モードを変更できません（コードが意図しないサーバーに送られないようにするため）。",
      "restrictedConfigurations": [
        "interlinear.server.mode",
        "interlinear.endpoint",
        "interlinear.server.llamaServerPath",
        "interlinear.server.modelPath"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:java",
    "onLanguage:csharp",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:shellscript",
    "onLanguage:css",
    "onLanguage:powershell"
  ],
  "contributes": {
    "commands": [
      {
        "command": "interlinear.setup",
        "title": "翻訳モデルをセットアップする",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.restartServer",
        "title": "翻訳サーバーを再起動する",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.showServerLog",
        "title": "翻訳サーバーのログを表示する",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.removeModels",
        "title": "ダウンロードしたモデルを削除する",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.toggle",
        "title": "有効/無効を切り替える",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.toggleInline",
        "title": "行末の訳文表示を切り替える",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.checkServer",
        "title": "翻訳サーバーへの接続を確認する",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.clearCache",
        "title": "翻訳キャッシュを削除する",
        "category": "Interlinear"
      },
      {
        "command": "interlinear.showMenu",
        "title": "メニューを開く",
        "category": "Interlinear"
      }
    ],
    "configuration": {
      "title": "Interlinear",
      "properties": {
        "interlinear.enabled": {
          "type": "boolean",
          "default": true,
          "description": "コメントの翻訳を有効にする。"
        },
        "interlinear.translateDocumentation": {
          "type": "boolean",
          "default": true,
          "description": "言語サーバーなどがホバーで表示するドキュメント（関数やクラスの説明）も翻訳する。"
        },
        "interlinear.inlineTranslation": {
          "type": "string",
          "enum": [
            "off",
            "short",
            "all"
          ],
          "enumDescriptions": [
            "表示しない（ホバーだけ）",
            "行コメント・行末コメントと、1行で書かれたコメント",
            "JSDoc などの複数行のブロックも含めるすべてのコメント"
          ],
          "default": "short",
          "description": "コメントの右側に訳文を表示する範囲。"
        },
        "interlinear.inlineMaxWidth": {
          "type": "number",
          "default": 120,
          "minimum": 40,
          "maximum": 1000,
          "markdownDescription": "コードと右側の訳文を合わせた1行の表示幅（桁数。全角文字は2桁）の目安。超える分は「…」で省略する（全文はホバーで読める）。編集領域の幅に合わせて調整する。"
        },
        "interlinear.server.mode": {
          "type": "string",
          "enum": [
            "managed",
            "external"
          ],
          "enumDescriptions": [
            "拡張が翻訳サーバー（llama-server）を起動・管理する。初回にモデルをダウンロードする",
            "interlinear.endpoint で指定した、自分で起動したサーバーを使う"
          ],
          "default": "managed",
          "markdownDescription": "翻訳サーバーの用意の仕方。指定していない場合、`interlinear.endpoint` を設定済みなら `external` として動く。"
        },
        "interlinear.server.model": {
          "type": "string",
          "enum": [
            "0.8b",
            "2b",
            "8b"
          ],
          "enumDescriptions": [
            "0.8B（0.6 GB）。軽量。GPU のない環境向け",
            "2B（1.8 GB）。推奨",
            "8B（5.3 GB）。高品質だが約 3 倍遅い"
          ],
          "default": "2b",
          "markdownDescription": "`managed` のときに使う翻訳モデル。ダウンロードしていないモデルを選んだら、コマンド「翻訳モデルをセットアップする」でダウンロードする。"
        },
        "interlinear.server.idleTimeoutMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "markdownDescription": "`managed` のとき、使われなくなってから翻訳サーバーを止めるまでの時間（分）。止めるとモデルが使っていたメモリが空く。次に使うときは起動に数秒かかる。0 なら止めない。"
        },
        "interlinear.server.llamaServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`managed` のときに使う llama-server のパス。空なら自動でダウンロードしたもの（CPU 版。macOS は Metal 対応）を使う。CUDA などの GPU 版を使いたい場合に指定する。 実行ファイルを指すため、ユーザー設定（リモートではリモートの設定）でだけ指定できる。",
          "scope": "machine"
        },
        "interlinear.server.modelPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "`managed` のときに使うモデル（GGUF）のパス。空なら `interlinear.server.model` のモデルを使う。 ユーザー設定（リモートではリモートの設定）でだけ指定できる。",
          "scope": "machine"
        },
        "interlinear.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:18080",
          "markdownDescription": "`interlinear.server.mode` が `external` のときに使う llama-server の URL。Dev Container からホストのサーバーを使う場合は `http://host.docker.internal:18080` など。"
        },
        "interlinear.targetLanguage": {
          "type": "string",
          "default": "ja",
          "description": "出力言語（ISO 639-1 コード。例: ja, en, zh, ko）。"
        },
        "interlinear.sourceLanguage": {
          "type": "string",
          "default": "",
          "description": "入力言語。空ならモデルが判定する。"
        },
        "interlinear.form": {
          "type": "string",
          "enum": [
            "plain",
            "polite",
            "none"
          ],
          "enumDescriptions": [
            "常体（だ・である）",
            "敬体（です・ます）",
            "指定しない"
          ],
          "default": "plain",
          "description": "日本語に訳すときの文体。"
        },
        "interlinear.useContext": {
          "type": "boolean",
          "default": true,
          "description": "ファイル名とコメント直後のコード行を、翻訳の参考情報としてモデルに渡す。"
        },
        "interlinear.glossary": {
          "type": "array",
          "default": [],
          "markdownDescription": "用語集。訳語を固定したい語を `{ \"source\": \"原語\", \"target\": \"訳語\" }` で指定する。",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              }
            }
          }
        },
        "interlinear.prefetch": {
          "type": "boolean",
          "default": true,
          "description": "画面に表示されているコメントを先に翻訳しておく。"
        },
        "interlinear.maxConcurrentRequests": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "markdownDescription": "同時に送る翻訳リクエストの数。llama-server の `--parallel`（`-np`）と同じ値にする。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p .",
    "test": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node esbuild.mjs --tests && node test/integration/run.ts",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "check:manifest": "node scripts/check-manifest.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitsutan/vscode-interlinear.git"
  },
  "bugs": {
    "url": "https://github.com/Mitsutan/vscode-interlinear/issues"
  },
  "homepage": "https://github.com/Mitsutan/vscode-interlinear#readme",
  "keywords": [
    "translation",
    "comment",
    "documentation",
    "hover",
    "japanese",
    "local",
    "llm",
    "llama.cpp",
    "plamo"
  ]
}
